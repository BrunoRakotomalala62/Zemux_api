# Secret obligatoire — ne jamais placer cette valeur dans Git.
ZENMUX_API_KEY=

# Paramètres facultatifs
ZENMUX_API_BASE_URL=https://zenmux.ai/api/v1
DEFAULT_REASONING_EFFORT=low
MAX_COMPLETION_TOKENS=2048
UPSTREAM_TIMEOUT_MS=50000
MAX_PROMPT_CHARS=12000
MAX_IMAGES=4
MAX_IMAGE_BYTES=4194304
RATE_LIMIT_PER_MINUTE=20
ALLOWED_ORIGINS=*

# Protection facultative de l'API publique
ZEMUX_API_TOKEN=

# Persistance facultative des conversations
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
